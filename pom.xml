<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.ee4j</groupId>
        <artifactId>project</artifactId>
        <version>2.0.6</version>
        <relativePath/>
    </parent>

    <groupId>jakarta.resource</groupId>
    <artifactId>jakarta.resource-parent</artifactId>
    <packaging>pom</packaging>
    <version>3.0.0-SNAPSHOT</version>

    <name>Jakarta Connectors</name>
    <description>Jakarta Connectors</description>
    <url>https://github.com/jakartaee/connectors</url>

    <scm>
        <connection>scm:git:ssh://git@github.com/jakartaee/connectors.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/jakartaee/connectors.git</developerConnection>
        <url>https://github.com/jakartaee/connectors</url>
      <tag>HEAD</tag>
    </scm>

    <properties>
         <!-- Project properties -->
         <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
         <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
         <maven.compiler.release>17</maven.compiler.release>

         <nexus.staging.repository>jca-maven2-staging</nexus.staging.repository>

         <!-- Versioning for API and SPEC-->
         <asciidoctor.maven.plugin.version>3.2.0</asciidoctor.maven.plugin.version>
         <asciidoctorj.version>3.0.1</asciidoctorj.version>
         <asciidoctorj.pdf.version>2.3.23</asciidoctorj.pdf.version>
         <jruby.version>9.4.14.0</jruby.version>
        
         <build.helper.plugin.version>3.6.1</build.helper.plugin.version>
         <spotbugs.version>4.9.8.3</spotbugs.version>
         <maven.complier.plugin.version>3.14.1</maven.complier.plugin.version>
         <maven.bundle.plugin.version>6.0.0</maven.bundle.plugin.version>
         <maven.jar.plugin.version>3.4.2</maven.jar.plugin.version>
         <maven.javadoc.plugin.version>3.12.0</maven.javadoc.plugin.version>
         <maven.release.plugin.version>3.3.1</maven.release.plugin.version>
         <maven.scm.provider.gitexe.version>2.2.1</maven.scm.provider.gitexe.version>
         <maven.assembly.plugin.version>3.8.0</maven.assembly.plugin.version>

         <!-- TODO update to EE12 versions -->
         <jakarta.transaction.version>2.0.1</jakarta.transaction.version>
         <jakarta.annotation.version>3.0.0</jakarta.annotation.version>
         <jakarta.enterprise.cdi.version>4.1.0</jakarta.enterprise.cdi.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-maven</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[${maven.compiler.release},)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.6.0,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>${build.helper.plugin.version}</version>
                <executions>
                    <!-- Parse spec.version: major.minor from project.version (e.g. 3.0 from 3.0.0-SNAPSHOT) -->
                    <execution>
                        <id>parse-spec-version</id>
                        <goals>
                            <goal>regex-property</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <name>spec.version</name>
                            <value>${project.version}</value>
                            <regex>^([0-9]+\.[0-9]+)\..*</regex>
                            <replacement>$1</replacement>
                            <failIfNoMatch>true</failIfNoMatch>
                        </configuration>
                    </execution>
                    <!-- Parse bundle.version (Takes the first three parts, e.g., 3.0.1 from 3.0.1-M1) -->
                    <execution>
                        <id>parse-bundle-version</id>
                        <goals>
                            <goal>regex-property</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <name>bundle.version</name>
                            <value>${project.version}</value>
                            <!-- Matches major.minor.micro and captures it -->
                            <regex>^([0-9]+\.[0-9]+\.[0-9]+).*</regex>
                            <replacement>$1</replacement>
                            <failIfNoMatch>true</failIfNoMatch>
                        </configuration>
                    </execution>
                    <!-- Parse doc.mark: DRAFT for -SNAPSHOT, -M*, -RC* versions -->
                    <execution>
                        <id>parse-doc-mark-draft</id>
                        <goals>
                            <goal>regex-property</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <name>doc.mark</name>
                            <value>${project.version}</value>
                            <regex>.*-(SNAPSHOT|M[0-9]+|RC[0-9]+).*</regex>
                            <replacement>DRAFT</replacement>
                            <failIfNoMatch>false</failIfNoMatch>
                        </configuration>
                    </execution>
                    <!-- Parse doc.mark: FINAL fallback when no DRAFT suffix matched -->
                    <execution>
                        <id>parse-doc-mark-final</id>
                        <goals>
                            <goal>regex-property</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <name>doc.mark</name>
                            <value>${doc.mark}</value>
                            <regex>^(?!DRAFT$).*$</regex>
                            <replacement>FINAL</replacement>
                            <failIfNoMatch>false</failIfNoMatch>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>api</module>
        <module>spec</module>
    </modules>

    <licenses>
        <license>
            <name>EPL 2.0</name>
            <url>http://www.eclipse.org/legal/epl-2.0</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>GPL2 w/ CPE</name>
            <url>https://www.gnu.org/software/classpath/license.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

</project>
